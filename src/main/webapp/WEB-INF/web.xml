<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
                             https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

	<display-name>SlimeFactory</display-name>

	<!--
		서블릿/필터는 @WebServlet, @WebFilter 애너테이션으로 등록한다.
		(metadata-complete 기본값 false → 애너테이션 스캔 활성)
		이 web.xml 은 welcome-file 과 error-page 매핑만 담당한다.
	-->

	<!-- 진입점: 앱 루트(/) 접속 시 index.jsp → /main 으로 forward -->
	<welcome-file-list>
		<welcome-file>index.jsp</welcome-file>
	</welcome-file-list>

	<!-- 세션 30분 -->
	<session-config>
		<session-timeout>30</session-timeout>
	</session-config>

	<!-- 예외/에러 페이지 매핑 -->
	<error-page>
		<error-code>404</error-code>
		<location>/pages/error/404.jsp</location>
	</error-page>
	<error-page>
		<error-code>500</error-code>
		<location>/pages/error/500.jsp</location>
	</error-page>
	<!-- 상품 없음 → 전용 예외 페이지로 forward -->
	<error-page>
		<exception-type>exception.ProductNotFoundException</exception-type>
		<location>/pages/error/notfound_product.jsp</location>
	</error-page>

</web-app>
